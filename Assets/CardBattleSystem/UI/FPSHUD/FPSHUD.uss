.fps-hud-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    justify-content: center;
    align-items: center;
}

.crosshair {
    width: 20px;
    height: 20px;
    justify-content: center;
    align-items: center;
    position: absolute;
}

.crosshair-line {
    background-color: white;
    position: absolute;
}

.crosshair-horizontal {
    width: 100%;
    height: 2px;
}

.crosshair-vertical {
    width: 2px;
    height: 100%;
}

.stats-container {
    position: absolute;
    bottom: 20px;
    left: 20px;
    background-color: rgba(0, 0, 0, 0.5);
    padding: 10px;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
}

.stat-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.stat-label {
    color: #aaaaaa;
    font-size: 14px;
    margin-right: 10px;
}

.stat-value {
    color: white;
    font-size: 18px;
    -unity-font-style: bold;
}

.health-bar-container {
    width: 200px;
    height: 10px;
    background-color: #333333;
    margin-top: 5px;
    border-radius: 2px;
    overflow: hidden;
}

.health-bar-fill {
    height: 100%;
    background-color: #ff4d4d;
    width: 100%;
}

.mana-bar-fill {
    height: 100%;
    background-color: #4d79ff;
    width: 100%;
}

.hud-hand-container {
    position: absolute;
    bottom: 20px;
    left: 50%;
    translate: -50% 0;
    width: 60%;
    height: 200px;
    justify-content: center;
    align-items: center;
}

.reorderable-list {
    flex-grow: 1;
    background-color: rgba(13, 13, 13, 0.5);
    border-radius: 8px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.horizontal-list {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
